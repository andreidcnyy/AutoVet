# AutoVet pet-owner portal - build-time settings (Vite).
# Copy to .env for local development; on Vercel set them under
# Project Settings -> Environment Variables. These values end up in the
# public JavaScript bundle, so never put secrets here.

# Google sign-in. Must match GOOGLE_CLIENT_ID on the backend, or every
# Google sign-in is refused.
VITE_GOOGLE_CLIENT_ID=

# Real-time updates (optional). Leave the key empty to switch real-time off.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Bot check on the sign-up form (Cloudflare Turnstile site key, public).
# Leave empty to hide it. Pair with TURNSTILE_SECRET_KEY on the backend:
# set both or neither, or every sign-up is refused.
VITE_TURNSTILE_SITE_KEY=
