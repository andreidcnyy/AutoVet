{
  "rewrites": [
    {
      "source": "/sanctum/:path*",
      "destination": "https://vibrant-abundance-production-4543.up.railway.app/sanctum/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vibrant-abundance-production-4543.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
