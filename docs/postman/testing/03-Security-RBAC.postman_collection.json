{
  "info": {
    "name": "AutoVet - Security Test: Role-Based Access Control",
    "description": "Each role can reach only what it is allowed to. Expected denials are the passing result.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Log in as client (pet owner)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Login succeeds (200) and returns a token', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(body.token).to.be.a('string');",
              "});",
              "pm.environment.set('client_token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"password\": \"{{password}}\",\n  \"source\": \"portal\"\n}"
        }
      }
    },
