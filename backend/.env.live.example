# =============================================================================
# Credentials for `php artisan db:pull-live`, which copies the production
# database down into your local one so you can inspect real data.
#
# Copy this file to `.env.live` (gitignored) and fill in the real values from
# Render -> autovet web service -> Environment. Delete `.env.live` when you are
# done; that is all it takes to remove this machine's access to production.
#
# This connection is opened READ-ONLY. Nothing in the app writes through it.
# =============================================================================

LIVE_DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
LIVE_DB_PORT=4000
LIVE_DB_DATABASE=autovet
LIVE_DB_USERNAME=<TiDB user, e.g. xxxxxxxx.root>
LIVE_DB_PASSWORD=<TiDB password>

# TiDB Serverless requires TLS. Any current CA bundle works.
LIVE_DB_SSL_CA=C:/xampp/apache/bin/curl-ca-bundle.crt
LIVE_DB_SSL_VERIFY=true
