# AutoVet backend - every setting the app reads, in one place.
#
# Copy to .env for local development. On Render, set these in the
# dashboard (Environment tab) instead - Render does not read .env files.
# Never commit real values; this file holds placeholders only.
#
# REQUIRED in production = the app breaks or is insecure without it.
# Everything else has a working default.

# --- Application -----------------------------------------------------------
APP_NAME=AutoVet
APP_ENV=local                 # REQUIRED in production: production
APP_KEY=                      # REQUIRED: php artisan key:generate --show
APP_DEBUG=true                # REQUIRED in production: false (true shows error details to users)
APP_URL=http://localhost      # REQUIRED in production: https://autovet.onrender.com

# Pet-owner portal address, used in emailed links (verify email, reset
# password, review request) and the post-verification redirect.
FRONTEND_PORTAL_URL=http://localhost:5174   # REQUIRED in production

# Clinic that self-registered portal clients (email or Google) join.
DEFAULT_CLINIC_ID=1

LOG_CHANNEL=stack
LOG_LEVEL=debug               # production: warning or error

# --- Database (TiDB in production, MySQL locally) --------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1             # REQUIRED in production
DB_PORT=3306                  # TiDB: 4000
DB_DATABASE=autovet           # REQUIRED in production
DB_USERNAME=root              # REQUIRED in production
DB_PASSWORD=                  # REQUIRED in production
MYSQL_ATTR_SSL_CA=            # TiDB: /etc/ssl/certs/ca-certificates.crt

# --- Sessions, cache, queue ------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Minutes a login stays valid (default 7 days). Shorter is safer: tokens
# are kept in the browser, where a malicious script could read them.
SANCTUM_EXPIRATION=10080
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,autovet-admin.vercel.app,autovet-portal.vercel.app

# Comma-separated list of sites allowed to call the API from a browser.
# Leave unset to use the built-in list (the Vercel apps, plus localhost
# outside production).
CORS_ALLOWED_ORIGINS=

# --- Sign in with Google ---------------------------------------------------
# REQUIRED for Google sign-in: without it every Google sign-in is refused.
# Must be the same client id as VITE_GOOGLE_CLIENT_ID in the portal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Brevo API; every mailer uses this key) -------------------------
MAIL_MAILER=log               # REQUIRED in production: brevo (log = write emails to the log only)
BREVO_API_KEY=                # REQUIRED in production
MAIL_FROM_ADDRESS=hello@example.com   # REQUIRED in production
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage (Supabase S3 in production) ------------------------------
FILESYSTEM_DISK=local         # production: s3
FILESYSTEM_PUBLIC=public      # production: s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Backups ----------------------------------------------------------------
# Render wipes its local disk on every redeploy, so backups kept there are
# lost. Set BACKUP_DISK=s3 and name a PRIVATE bucket (create one in Supabase
# Storage with "Public bucket" switched OFF). Do not reuse AWS_BUCKET: that
# bucket is public and backup names are guessable dates.
# The access keys default to the AWS_* ones above.
BACKUP_DISK=local
BACKUP_AWS_BUCKET=

# --- AI features -----------------------------------------------------------
ANTHROPIC_API_KEY=            # AI clinical support; the feature is off without it
PYTHON_BIN_PATH=python3       # inventory forecasting; Render image: /opt/venv/bin/python
AI_API_URL=

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for GET /api/cron/check-expiry (sent as a Bearer token).
CRON_SECRET=                  # REQUIRED if the cron endpoint is used

# --- Real-time updates (optional) -------------------------------------------
BROADCAST_CONNECTION=log      # log = off; pusher or reverb to turn on
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

# --- Error tracking (optional) -----------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Clinic-to-portal sync (legacy, off unless SYNC_IS_CLINIC=true) ----------
SYNC_IS_CLINIC=false
SYNC_PORTAL_URL=
SYNC_SECRET=

# --- Local tools only: copy the live database down (php artisan db:pull-live) -
LIVE_DB_HOST=
LIVE_DB_PORT=4000
LIVE_DB_DATABASE=
LIVE_DB_USERNAME=
LIVE_DB_PASSWORD=
LIVE_DB_SSL_CA=
LIVE_DB_SSL_VERIFY=true
