# =============================================================================
# AutoVet backend — environment variables for Render.
# Copy these into Render → your web service → Environment. Do NOT commit real
# secrets. Values marked <FROM ...> come from your existing local backend/.env.
# =============================================================================

APP_NAME=AutoVet
APP_ENV=production
APP_DEBUG=false
# Generate once with `php artisan key:generate --show`, or reuse your local key.
APP_KEY=<FROM local .env APP_KEY>
# Set to your Render URL after the service is created, e.g.
APP_URL=https://autovet-backend.onrender.com

# --- Database: TiDB Serverless (MySQL-compatible) --------------------------
DB_CONNECTION=mysql
DB_HOST=<TiDB host, e.g. gateway01.<region>.prod.aws.tidbcloud.com>
DB_PORT=4000
DB_DATABASE=autovet
DB_USERNAME=<TiDB user, e.g. xxxxxxxx.root>
DB_PASSWORD=<TiDB password>
# TiDB requires TLS. This CA bundle ships in the Docker image.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- No Redis on free tier: run stateless / inline -------------------------
CACHE_STORE=file
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
# sync = queued jobs (AI forecast refresh) run inline; no separate worker needed.
QUEUE_CONNECTION=sync
# Real-time push off for now (no Reverb process on free tier). App works on
# refresh. To restore live updates later, switch to Pusher (already installed).
BROADCAST_CONNECTION=log

# --- AI: subprocess runs inside this image (Python bundled in Dockerfile) ---
# Bundled interpreter; leave as-is. The old Railway AI_API_URL is retired.
PYTHON_BIN_PATH=/opt/venv/bin/python

# --- Anthropic (clinical support) ------------------------------------------
ANTHROPIC_API_KEY=<FROM local .env ANTHROPIC_API_KEY>

# --- Mail (Brevo) ----------------------------------------------------------
MAIL_MAILER=brevo
BREVO_API_KEY=<FROM local .env BREVO_API_KEY>
MAIL_FROM_ADDRESS=greenhillsdishcovery@gmail.com
MAIL_FROM_NAME="Pet Wellness Animal Clinic"
MAIL_PASSWORD_APPOINTMENT=<FROM local .env>
MAIL_PASSWORD_REMINDER=<FROM local .env>
MAIL_PASSWORD_FORGOT=<FROM local .env>
MAIL_PASSWORD_INVOICE=<FROM local .env>
MAIL_PASSWORD_VERIFICATION=<FROM local .env>

# --- File uploads (Supabase S3 — unchanged, keeps existing images) ---------
FILESYSTEM_DISK=s3
FILESYSTEM_PUBLIC=s3
AWS_ACCESS_KEY_ID=<FROM local .env>
AWS_SECRET_ACCESS_KEY=<FROM local .env>
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=autovet-storage
AWS_ENDPOINT=https://zhujxjkusoetamtpotjh.storage.supabase.co/storage/v1/s3
AWS_URL=https://zhujxjkusoetamtpotjh.supabase.co/storage/v1/object/public/autovet-storage
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=<FROM local .env>
GOOGLE_CLIENT_SECRET=<FROM local .env>

# --- Misc ------------------------------------------------------------------
CRON_SECRET=<FROM local .env CRON_SECRET>
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,autovet-admin.vercel.app,autovet-portal.vercel.app
# Sentry (optional) — leave blank to disable error reporting.
# SENTRY_LARAVEL_DSN=
